# Copy this file to .env (setup-windows.bat does it for you) and fill in your key.

# Local SQLite database - no PostgreSQL install needed
DATABASE_URL=sqlite:///./datamind.db

# JWT secret - change to any long random string
SECRET_KEY=change-me-to-a-long-random-string

# LLM (optional). Dataset insight questions (best model, unnecessary/important
# columns, relationships) work WITHOUT a key; free-form chat needs one.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
